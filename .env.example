# --- NVIDIA API ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Hugging Face (for pyannote diarization) ---
HF_TOKEN=hf_your_huggingface_token_here

# --- PostgreSQL ---
POSTGRES_USER=sentiment
POSTGRES_PASSWORD=sentiment
POSTGRES_DB=sentiment
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentiment:sentiment@localhost:5432/sentiment

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Audio ---
MAX_FILE_SIZE_MB=50
MIN_DURATION_SECONDS=1.0
TEMP_DIR=/tmp/sentiment_audio

# --- DSP Loudness Thresholds (dBFS) ---
DSP_WHISPER_THRESHOLD=-40.0
DSP_QUIET_THRESHOLD=-30.0
DSP_NORMAL_THRESHOLD=-20.0
DSP_LOUD_THRESHOLD=-10.0
# Above -10.0 = shouting

# --- LLM ---
LLM_TIMEOUT_SECONDS=300
LLM_REASONING_BUDGET=4096
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# --- Chunking ---
CHUNK_MIN_DURATION_S=60
CHUNK_MAX_DURATION_S=120

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO